<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_barstone" model="ir.ui.view">
        <field name="name">sale.order.form.barstone</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_barstone_simulation" type="object" class="oe_stat_button" icon="fa-cube">
                    <div class="o_stat_info"><span class="o_stat_text">הדמיה</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
